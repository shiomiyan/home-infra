use flake

watch_file flake.nix
watch_file secrets/meterplus.yaml

if ! has sops; then
  log_error "sops is required to load secrets/meterplus.yaml"
  exit 1
fi

# Keep local development aligned with the deployed service env names so the
# same encrypted source of truth can feed both paths.
export SWITCHBOT_TOKEN="$(sops decrypt --extract '["SWITCHBOT_TOKEN"]' secrets/meterplus.yaml)"
export SWITCHBOT_CLIENT_SECRET="$(sops decrypt --extract '["SWITCHBOT_CLIENT_SECRET"]' secrets/meterplus.yaml)"
export SWITCHBOT_METERPLUS_DEVICE_ID="$(sops decrypt --extract '["SWITCHBOT_METERPLUS_DEVICE_ID"]' secrets/meterplus.yaml)"
